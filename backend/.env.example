OPENWEBNINJA_API_KEY=
DATABASE_URL=sqlite:///./dealsniper.db
MATCH_ALERT_THRESHOLD=70
CORS_ORIGINS=*

# Reuse DB results for the same retailer+query this long (seconds).
# 28800 = 8 hours ≈ 3 live searches per day for e.g. amazon/tv.
SEARCH_CACHE_TTL_SECONDS=28800
# Only store products at or above this discount % (skip full-price catalog noise).
MIN_INGEST_PCT_OFF=5

# Docker Compose overrides DATABASE_URL to sqlite:////data/dealsniper.db
# so the DB lives on the dealsniper_data volume.