server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # Hashed build assets (index-<hash>.js) are content-addressed -- a new build
  # gets a new URL, so the old one can never be served stale. Cache forever.
  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable" always;
  }

  location / {
    # index.html names the hashed bundles, so a stale copy pins the browser to
    # an old build. Sending no Cache-Control made browsers fall back to
    # heuristic freshness (~10% of the doc's age) -- a 5-week-old build stayed
    # "fresh" for ~3.5 days without revalidating, so deploys were invisible.
    add_header Cache-Control "no-cache" always;
    try_files $uri $uri/ /index.html;
  }

  location ~ ^/(deals|preferences|devices|refresh|health) {
    proxy_pass ${API_UPSTREAM};
    proxy_ssl_server_name on;
    proxy_http_version 1.1;
    # $proxy_host (the upstream's own host), NOT $host (the original
    # client-facing request host) -- Azure App Service's shared front-end
    # routes by Host header, so forwarding dealsniper-web's own hostname
    # to dealsniper-api's upstream leaves Azure unable to route the
    # request, which is what caused the proxied requests to 400.
    proxy_set_header Host $proxy_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

    # A forced refresh (POST /refresh, force=true) does live OpenWebNinja work
    # across every configured retailer *sequentially* -- up to ~19 calls at a
    # 30s per-call httpx timeout -- so it routinely exceeds nginx's default 60s
    # proxy_read_timeout. That default is what made SAVE & REFRESH return
    # nginx's own 504 page while the backend went on to finish and commit its
    # rows anyway (confirmed by last_seen advancing after the "failed" request).
    #
    # 200s, not higher: Azure App Service's front end imposes its own
    # non-configurable ~230s (Windows) / ~240s (Linux) idle timeout, at BOTH
    # this web app's front end and the API app's. Staying under it means nginx
    # emits a 504 we control and can classify, instead of Azure silently
    # dropping the connection.
    #
    # proxy_connect_timeout stays short and separate: an *unreachable* upstream
    # should fail fast rather than sit for 200s.
    proxy_connect_timeout 10s;
    proxy_send_timeout 200s;
    proxy_read_timeout 200s;
  }
}
